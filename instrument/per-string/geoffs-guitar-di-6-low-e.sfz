// Geoff's Guitar DI: string 6 (LowE) alone, for one sampler per string
// Samples and SFZ files: CC BY 4.0, Geoffrey Waggott (LICENSE; no credit
// needed for music made with them). Built by tools/build.py.

<control>
default_path=../Samples/
set_cc74=127

<global>
bend_up=1200 bend_down=-1200
amp_veltrack=100 amp_velcurve_0=0.0397 amp_velcurve_95=1 amp_velcurve_127=1
ampeg_attack=0 ampeg_release=0.2 loop_mode=no_loop group=1 polyphony=1

// open: picked when no other note is held, else legato
<group> locc74=96 hicc74=127 trigger=first
<region> lokey=38 hikey=40 pitch_keycenter=40 lovel=1 hivel=42 volume=17.17 tune=0.2 sample=LowE_f00_soft.flac
