<control>
default_path=Samples/
set_cc74=127

<global>
bend_up=1200 bend_down=-1200
amp_veltrack=100 amp_velcurve_0=0.0397 amp_velcurve_95=1 amp_velcurve_127=1
ampeg_attack=0 ampeg_release=0.2 loop_mode=no_loop sw_lokey=24 sw_hikey=26 sw_default=24
// keyswitches: C1 open, C#1 palm mute, D1 dead; legato while CC68 (legato pedal) is down

